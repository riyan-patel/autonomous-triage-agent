# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=

# GitHub PAT - local-dev auth for mcp-server, until GitHub App installation
# tokens are wired up at deploy time
GITHUB_TOKEN=

# LLM provider (swappable)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# Postgres (pgvector) - psycopg3 driver
DATABASE_URL=postgresql+psycopg://triage:triage@localhost:5432/triage_agent

# Redis
REDIS_URL=redis://localhost:6379/0

# Agent policy
AUTONOMY_CONFIDENCE_THRESHOLD=0.85
DRY_RUN=true

# Dashboard - queries Postgres directly (see dashboard/lib/db.js), so it
# needs its own DATABASE_URL without the +psycopg driver suffix the Python
# services use above:
# DATABASE_URL=postgresql://triage:triage@localhost:5432/triage_agent
