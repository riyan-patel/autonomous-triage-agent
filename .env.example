# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=

# GitHub PAT - local-dev auth for mcp-server, until GitHub App installation
# tokens are wired up at deploy time
GITHUB_TOKEN=

# LLM provider (swappable): "anthropic" or "gemini"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Default model is provider-dependent (claude-sonnet-5 / gemini-flash-lite-latest)
# if left unset - see agent-core/agent_core/config.py
LLM_MODEL=

# Postgres (pgvector) - psycopg3 driver
DATABASE_URL=postgresql+psycopg://triage:triage@localhost:5432/triage_agent

# Redis
REDIS_URL=redis://localhost:6379/0

# Agent policy
AUTONOMY_CONFIDENCE_THRESHOLD=0.85
DRY_RUN=true

# Dashboard - queries Postgres directly (see dashboard/lib/db.js), so it
# needs its own DATABASE_URL without the +psycopg driver suffix the Python
# services use above:
# DATABASE_URL=postgresql://triage:triage@localhost:5432/triage_agent

# Shared secret the dashboard presents to webhook-ingress's
# /internal/approvals/{id}/execute endpoint when a human clicks Approve -
# unset means that endpoint is closed (fails closed). Generate with e.g.
# `openssl rand -hex 24`. Both webhook-ingress and dashboard need this
# set to the same value.
INTERNAL_API_TOKEN=
# Dashboard-only: where it reaches webhook-ingress from (docker-compose
# service name inside the compose network, localhost for local dev).
WEBHOOK_INGRESS_URL=http://localhost:8000
